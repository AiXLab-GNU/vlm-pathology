!.worktrees/registry.csv

# Canonical local datasets and resource workspaces
resources/data/shared/opendataset
resources/data/shared/song-datasets/
resources/data/*/local-data/
resources/projects/*/*
!resources/projects/README.md
!resources/projects/precise_pni_candidate_triage/
!resources/projects/precise_pni_candidate_triage/README.md
!resources/projects/quantitative_foundation_model_validation/
!resources/projects/quantitative_foundation_model_validation/README.md
